# Ollama API configuration
OLLAMA_HOST=http://host.docker.internal:11434

# --- Klassificerare ---
# chat = vanlig chattmodell svarar med fritext (fungerar med alla modeller)
# clef = Cloudflare Clef/Clef-flash via /v1/systemone, typat schema + sannolikheter
#        Kräver Ollama >= 0.35.1
CLASSIFIER=chat

# Modell för chat-lane
MODEL_NAME=gemma3:4b

# Modell för clef-lane: clef-flash (9B, ~11 GB) eller clef:27b (~18 GB)
CLEF_MODEL_NAME=clef-flash

# Clef: nedskalning (längsta sida) och tröskel för "oskarp"
# CLEF_MAX_PX=768: mätt 2,7 s/bild mot 4,7 s vid 1280 px, utan synbar kvalitetstapp
# BLUR_THRESHOLD=0.9: mätt 2026-10-09 på 28 bilder med exakt facit -> 8/8 sant
#   suddiga (prob >= 0,979), 0 falska positiva. Default 0.5 gav 5 FP.
CLEF_MAX_PX=768
BLUR_THRESHOLD=0.9
CLEF_TIMEOUT=180
KEEP_ALIVE=10m

# --- Second opinion (endast clef-lanen) ---
# När Clef:s confidence understiger SECOND_OPINION_THRESHOLD får en annan
# modell titta på samma bild. Tom SECOND_OPINION = avstängt.
# SECOND_OPINION_MODEL: valfri vision-modell, t.ex. gemma3:4b (3,3 GB),
#                        moondream (1,7 GB), llava:7b (4,7 GB)
# SECOND_OPINION_MODE:   veto    = andra modellen får bara rädda bilder
#                        agree   = fäll bara om BÅDA flaggar problem
#                        override = andra modellens svar vinner
SECOND_OPINION=clef
SECOND_OPINION_MODEL=gemma3:4b
SECOND_OPINION_THRESHOLD=0.8
SECOND_OPINION_MODE=veto

# Folder structure for image sorting
INPUT_FOLDER=images
BAD_QUALITY_FOLDER_NAME=bad_quality
OK_QUALITY_FOLDER_NAME=ok
SCREENSHOT_FOLDER_NAME=screenshots

# Supported image file extensions
SUPPORTED_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.webp,.heic,.heif

# Categories for bad quality images (chat-lane: fritextmatchning)
BAD_CATEGORIES=screenshot,blurry,low resolution,low quality

# chat-lanen: svar som i stället ska till SCREENSHOT_FOLDER_NAME. Läses före
# BAD_CATEGORIES, eftersom "screenshot" står i båda listorna.
SCREENSHOT_CATEGORIES=screenshot,photo of screen

# Parallella klassificeringsanrop. Kräver OLLAMA_NUM_PARALLEL >= WORKERS på
# maskinen som kör Ollama (starta om Ollama efteråt), OCH att modellen lämnar
# VRAM över till flera samtidiga slots. clef-flash (~11 GB) lämnar inget på ett
# 12 GB-kort — en liten chat-modell som gemma3:4b (~3 GB) gör det.
# Mät: kör samma mapp med WORKERS=1 och WORKERS=4 och jämför totaltid.
WORKERS=1
